generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model drawers {
  id                Int                 @id @default(autoincrement())
  name              String              @db.VarChar
  user_id           Int
  users             users               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  drawers_and_notes drawers_and_notes[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model school_partners {
  school_email       String    @id @db.VarChar
  active_partnership String    @db.VarChar
  school_name        String    @db.VarChar
  schools            schools[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model schools {
  id              Int             @id @default(autoincrement())
  email           String          @db.VarChar
  password        String          @db.VarChar
  colors          Json?
  school_partners school_partners @relation(fields: [email], references: [school_email], onDelete: Cascade)
  subscriptions   subscriptions[]
  users           users[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model subscriptions {
  email               String   @id @db.VarChar
  key_expiration_date DateTime @db.Date
  school_id           Int
  languages           String
  schools             schools  @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users               users?
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id                            Int           @id @unique(map: "id") @default(autoincrement())
  first_name                    String
  last_name                     String
  email                         String        @unique(map: "unique_email")
  password                      String
  refresh_token                 String?
  refresh_token_expiration_date DateTime?
  email_verified                Boolean       @default(false)
  school_id                     Int
  languages                     String        @db.VarChar
  drawers                       drawers[]
  notes                         notes[]
  subscriptions                 subscriptions @relation(fields: [email], references: [email], onDelete: Cascade)
  schools                       schools       @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model dictionary_words {
  id       Int     @id @default(autoincrement())
  meanings Json
  audio    String? @db.VarChar
  word     String  @db.VarChar
  notes    notes[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model notes {
  id                Int                 @id(map: "words_pkey") @unique(map: "words_id_key") @default(autoincrement())
  is_learned            Boolean
  user_notes        String
  repetitions       Int
  days              Int
  review_date       DateTime
  ease_factor       Float
  user_id           Int
  language          String
  word_id           Int
  drawers_and_notes drawers_and_notes[]
  dictionary_words  dictionary_words    @relation(fields: [word_id], references: [id], onDelete: Cascade)
  users             users               @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "words_user_id_fkey")
}

model drawers_and_notes {
  drawer_id Int
  note_id   Int
  drawers   drawers @relation(fields: [drawer_id], references: [id], onDelete: Cascade, map: "drawers_and_words_drawer_id_fkey")
  notes     notes   @relation(fields: [note_id], references: [id], onDelete: Cascade, map: "drawers_and_words_note_id_fkey")

  @@id([drawer_id, note_id], map: "drawers_and_words_pkey")
}
